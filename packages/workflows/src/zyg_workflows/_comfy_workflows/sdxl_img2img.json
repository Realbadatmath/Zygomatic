{
  "10": {
    "inputs": {
      "ckpt_name": "Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load SDXL Checkpoint"}
  },
  "14": {
    "inputs": {"image": "reference.png"},
    "class_type": "LoadImage",
    "_meta": {"title": "Reference Image (dataset portrait)"}
  },
  "15": {
    "inputs": {
      "pixels": ["14", 0],
      "vae": ["10", 2]
    },
    "class_type": "VAEEncode",
    "_meta": {"title": "Encode Reference to Latent"}
  },
  "20": {
    "inputs": {
      "text": "character portrait, consistent identity",
      "clip": ["10", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"}
  },
  "21": {
    "inputs": {
      "text": "blurry, low quality, deformed face, bad anatomy",
      "clip": ["10", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"}
  },
  "30": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent (fallback sizing)"}
  },
  "31": {
    "inputs": {
      "seed": 42,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.52,
      "model": ["10", 0],
      "positive": ["20", 0],
      "negative": ["21", 0],
      "latent_image": ["15", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "Img2Img KSampler"}
  },
  "40": {
    "inputs": {
      "samples": ["31", 0],
      "vae": ["10", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "50": {
    "inputs": {
      "filename_prefix": "ZygSDXLImg2Img",
      "images": ["40", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save"}
  }
}
