{
  "1": {
    "inputs": {
      "model": "Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors",
      "base_precision": "bf16",
      "quantization": "fp8_e4m3fn",
      "load_device": "offload_device",
      "attention_mode": "sdpa"
    },
    "class_type": "WanVideoModelLoader",
    "_meta": {"title": "Load Wan I2V Model"}
  },
  "2": {
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16"
    },
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": {"title": "Load Wan T5 Text Encoder"}
  },
  "3": {
    "inputs": {
      "model_name": "open-clip-xlm-roberta-large-vit-huge-14_visual_fp32.safetensors",
      "precision": "fp16"
    },
    "class_type": "LoadWanVideoClipTextEncoder",
    "_meta": {"title": "Load Wan CLIP Vision"}
  },
  "4": {
    "inputs": {
      "model_name": "Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16"
    },
    "class_type": "WanVideoVAELoader",
    "_meta": {"title": "Load Wan VAE"}
  },
  "10": {
    "inputs": {"image": "input_image.png"},
    "class_type": "LoadImage",
    "_meta": {"title": "Source FLUX Image"}
  },
  "12": {
    "inputs": {
      "clip_vision": ["3", 0],
      "image_1": ["10", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    },
    "class_type": "WanVideoClipVisionEncode",
    "_meta": {"title": "CLIP Vision Encode"}
  },
  "11": {
    "inputs": {
      "width": 832,
      "height": 480,
      "num_frames": 65,
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": true,
      "vae": ["4", 0],
      "clip_embeds": ["12", 0],
      "start_image": ["10", 0]
    },
    "class_type": "WanVideoImageToVideoEncode",
    "_meta": {"title": "I2V Image Encode"}
  },
  "20": {
    "inputs": {
      "positive_prompt": "cinematic camera movement, atmospheric drift",
      "negative_prompt": "static, frozen, no motion, deformed anatomy, extra limbs",
      "t5": ["2", 0]
    },
    "class_type": "WanVideoTextEncode",
    "_meta": {"title": "Wan Text Encode"}
  },
  "30": {
    "inputs": {
      "model": ["1", 0],
      "image_embeds": ["11", 0],
      "text_embeds": ["20", 0],
      "steps": 20,
      "cfg": 5.0,
      "shift": 2.5,
      "seed": 42,
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "force_offload": true
    },
    "class_type": "WanVideoSampler",
    "_meta": {"title": "Wan I2V Sampler"}
  },
  "40": {
    "inputs": {
      "vae": ["4", 0],
      "samples": ["30", 0],
      "enable_vae_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    },
    "class_type": "WanVideoDecode",
    "_meta": {"title": "Wan VAE Decode"}
  },
  "45": {
    "inputs": {"images": ["40", 0], "fps": 17.0},
    "class_type": "CreateVideo",
    "_meta": {"title": "Create Video"}
  },
  "50": {
    "inputs": {
      "video": ["45", 0],
      "filename_prefix": "ZygWanI2V",
      "format": "mp4",
      "codec": "h264"
    },
    "class_type": "SaveVideo",
    "_meta": {"title": "Save MP4"}
  }
}
