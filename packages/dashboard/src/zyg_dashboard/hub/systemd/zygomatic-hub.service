[Unit]
Description=Zygomatic hub server (port 7000)
PartOf=zygomatic.target
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=zygomatic
WorkingDirectory=/home/zygomatic/Zygomatic/hub
ExecStart=/usr/bin/python3 hub_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target zygomatic.target
