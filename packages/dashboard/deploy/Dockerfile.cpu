# ═══════════════════════════════════════════════════════════════════════════════
# Zygomatic dashboard — CPU-only image
# For testing or deployment without an NVIDIA GPU. Every route that renders
# (FLUX, Orpheus TTS, upscales, Blender) needs a GPU and will fail on this image;
# the GUI, the kanban board, the metrics hubs and the API tests do not.
#
# Build context is the REPOSITORY ROOT:
#   docker build -f deploy/Dockerfile.cpu -t zygomatic-dashboard:cpu .
#   docker compose -f deploy/docker-compose.cpu.yml up
# ═══════════════════════════════════════════════════════════════════════════════

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# ── System packages ────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libsndfile1-dev \
    portaudio19-dev \
    espeak \
    espeak-ng \
    libsm6 \
    libxext6 \
    libglib2.0-0 \
    libgomp1 \
    libgl1-mesa-glx \
    git \
    curl \
    wget \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

WORKDIR /app

# ── PyTorch, CPU wheels — before the package, so nothing pulls the CUDA build ──
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision torchaudio

# ── The package itself, from pyproject.toml ───────────────────────────────────
COPY . /app
RUN pip install --no-cache-dir -e .

RUN python -m playwright install --with-deps chromium

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ZYG_OLLAMA_URL=http://ollama:11434 \
    ZYG_DATA_ROOT=/app/data \
    ZYG_OUTPUT_ROOT=/app/output \
    ZYG_MODELS_ROOT=/models

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:5000/ -o /dev/null || exit 1

ENTRYPOINT ["/app/deploy/docker-entrypoint.sh"]
