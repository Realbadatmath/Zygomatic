[Unit]
Description=Medusa Presets — preset-driven submitter through the guarded entry (port 5301)
# Code lives in zygomatic-zero-public (zyg_zero.medusa) — see medusa.service.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/zygomatic-zero-public
EnvironmentFile=%h/.config/zygomatic/env
ExecStart=%h/repos/.venv/bin/python -m zyg_zero.medusa.medusa_presets
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
