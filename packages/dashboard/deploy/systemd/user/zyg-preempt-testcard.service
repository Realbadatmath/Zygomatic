[Unit]
Description=Zygomatic — refresh the Pre-emptive bank Test Data card

# Why this exists (2026-09-23): the pre-emptive bank build is a test that runs for
# weeks — 100 documentary brains at ~2 % of a Claude week each, plus 100 song briefs.
# The Analytics card computes itself from the bank's files on every request, but the
# Test Data card is a STORED record: without a refresh it would freeze at whatever the
# bank held the moment it was first written. This re-records it (replace=True) from the
# same files, so the card tracks the run instead of describing its first minute.

[Service]
Type=oneshot
WorkingDirectory=%h/repos/zygomatic-dashboard
EnvironmentFile=%h/.config/zygomatic/env
ExecStart=%h/repos/.venv/bin/python -m zyg_dashboard.preempt_test_record
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zyg-preempt-testcard
